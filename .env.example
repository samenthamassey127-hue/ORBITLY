# ─────────────────────────────────────────────
# ORBITLY Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# ── AI (optional but recommended) ────────────
# Get your key from https://aistudio.google.com
GEMINI_API_KEY=

# ── External APIs ─────────────────────────────
CELESTRAK_BASE=https://celestrak.org
LAUNCH_LIBRARY_BASE=https://ll.thespacedevs.com/2.3.0

# ── Cache ─────────────────────────────────────
CACHE_TTL_SECONDS=900        # 15 minutes for TLE data
DISK_CACHE_DIR=./cache       # Relative to backend dir

# ── CORS (add your production URL here) ───────
# Comma-separated list in code; add yours in config.py
# CORS_ORIGINS=http://localhost:5173,https://orbitly.vercel.app

# ── Server ────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false
